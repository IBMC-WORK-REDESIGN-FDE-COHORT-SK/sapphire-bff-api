# Server Configuration
PORT=4000

# Segment Analytics (server-side)
SEGMENT_WRITE_KEY=your-segment-write-key-here

# Keycloak Configuration
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/sapphire-ui/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8090/realms/sapphire-ui
KEYCLOAK_TOKEN_URL=http://localhost:8090/realms/saphhire-ui/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=charting-api
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# REST API Base URLs
HEALTH_METRICS_API_URL=http://localhost:8089/api/v1
TRENDS_API_URL=http://localhost:8089/api/v1
READINGS_API_URL=http://localhost:3004/api
INSIGHTS_API_URL=http://localhost:3005/api
PARTNERS_API_URL=http://localhost:8085/sapphire-wellness-partner-service
PARTNER_SERVICES_API_URL=http://localhost:8085/sapphire-wellness-partner-service
PARTNER_ONBOARDING_API_URL=http://localhost:8086/business-onboarding/partner-onboarding
PARTNER_SERVICES_ONBOARDING_API_URL=http://localhost:8086/business-onboarding/service-onboarding
USERS_API_URL=http://localhost:8091/api/v1
RECOMMENDATIONS_API_URL=http://localhost:8095/api/v1
PARTNER_SEARCH_SERVICE_URL=http://localhost:8092

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_SERVICE_NAME=sapphire-bff-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_LOG_LEVEL=info

# Environment
NODE_ENV=development